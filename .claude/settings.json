{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [

      "Bash(uv --help *)",
      "Bash(uv *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.envrc)",
      "Read(**/.pytest_cache)",
      "Read(**/.ruff_cache)"
    ],
    "ask": []
  },
  "extraKnownMarketplaces": {
    "my-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "michellepace/my-claude-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "git-utils@my-claude-marketplace": true
  }
}
